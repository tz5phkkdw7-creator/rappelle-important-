<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="theme-color" content="#fff1f6">
<title>Rappel Important</title>
<style>
:root{--rose:#f4bfd3;--clair:#fff1f6;--fonce:#b94f7a;--texte:#493640;--gris:#806f78;--ligne:#f0dfe7}*{box-sizing:border-box}body{margin:0;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:linear-gradient(145deg,#fff8fb,#fff0f6);color:var(--texte)}button,input,textarea,select{font:inherit}button{cursor:pointer}.app{max-width:760px;margin:auto;min-height:100vh;padding:16px 14px 95px}header{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:8px 2px 18px}.brand{display:flex;align-items:center;gap:10px}.logo{width:46px;height:46px;border-radius:16px;background:linear-gradient(140deg,var(--rose),#fff);display:grid;place-items:center;font-size:24px}h1{font-size:20px;margin:0}.subtitle{font-size:12px;color:var(--gris);margin-top:3px}.small-btn,.secondary{background:#fff;border:1px solid var(--ligne);border-radius:14px;padding:10px 12px;color:var(--texte)}.hero{padding:22px;border-radius:25px;background:linear-gradient(135deg,#f8d5e3,#fff);margin-bottom:18px;border:1px solid #f8e4ec}.eyebrow{font-size:12px;font-weight:800;text-transform:uppercase;color:var(--fonce)}.hero h2{font-size:27px;line-height:1.18;margin:10px 0}.hero p{line-height:1.55;margin:0;color:#684f5b}.hero-actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:17px}.primary{background:var(--fonce);color:white;border:0;border-radius:14px;padding:12px 15px;font-weight:750}.section-head{display:flex;justify-content:space-between;align-items:center;gap:8px;margin:23px 2px 12px}.section-head h3{margin:0;font-size:17px}.section-head span{font-size:12px;color:var(--gris)}.search,input[type=text],textarea,select{width:100%;border:1px solid var(--ligne);border-radius:14px;padding:13px;background:#fff;outline:none;color:var(--texte)}.categories{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}.category{border:1px solid var(--ligne);background:#fff;border-radius:16px;padding:13px 6px;text-align:center;color:var(--texte);min-height:82px}.category .emoji{font-size:0;display:block;margin-bottom:7px}.category .emoji svg{width:28px;height:28px;display:inline-block}.nav-emoji{height:25px;display:flex;align-items:center;justify-content:center;margin-bottom:3px}.category span:last-child{font-size:12px;font-weight:750}.category.active{background:#fbe0ea;border-color:#e9aac4}.card{background:#fff;border:1px solid #f4e7ed;border-radius:20px;padding:16px;margin-bottom:11px}.card-top{display:flex;justify-content:space-between;gap:10px;align-items:center}.tag{font-size:11px;background:var(--clair);color:var(--fonce);padding:6px 9px;border-radius:20px;font-weight:800}.favorite{border:0;background:transparent;font-size:23px;color:#c9b8c0}.favorite.saved{color:#d34f88}.reminder-text{font-size:16px;line-height:1.6;margin:12px 0 14px}.card-actions{display:flex;gap:8px;flex-wrap:wrap}.card-actions button{border:1px solid var(--ligne);background:#fff;border-radius:11px;padding:8px 11px;font-size:12px;color:var(--texte)}.panel{display:none}.panel.active{display:block}.form-stack{display:grid;gap:10px}textarea{min-height:110px;resize:vertical}.empty{padding:24px;text-align:center;color:var(--gris);background:#fff;border-radius:18px;border:1px dashed var(--ligne)}.note{font-size:12px;line-height:1.5;color:var(--gris);margin-top:15px}nav{position:fixed;bottom:0;left:0;right:0;background:#ffffffef;border-top:1px solid var(--ligne);display:flex;justify-content:center;gap:3px;padding:8px 5px calc(8px + env(safe-area-inset-bottom));z-index:5}nav button{border:0;background:transparent;color:var(--gris);border-radius:13px;padding:8px 7px;min-width:58px;font-size:11px}nav .nav-emoji{display:block;font-size:20px;margin-bottom:3px}nav button.active{background:var(--clair);color:var(--fonce);font-weight:800}.toast{position:fixed;bottom:90px;left:50%;transform:translateX(-50%);background:#493640;color:#fff;padding:11px 15px;border-radius:12px;font-size:13px;display:none;z-index:10}@media(min-width:600px){.categories{grid-template-columns:repeat(6,1fr)}.hero h2{font-size:32px}}
</style></head><body><div class="app"><header><div class="brand"><div class="logo" aria-label="Illustration de fleur"><svg viewBox="0 0 48 48" width="30" height="30" role="img" aria-label="Fleur rose"><g fill="#d87093"><ellipse cx="24" cy="12" rx="6" ry="10"/><ellipse cx="24" cy="36" rx="6" ry="10"/><ellipse cx="12" cy="24" rx="10" ry="6"/><ellipse cx="36" cy="24" rx="10" ry="6"/><ellipse cx="16" cy="16" rx="6" ry="9" transform="rotate(-45 16 16)"/><ellipse cx="32" cy="16" rx="6" ry="9" transform="rotate(45 32 16)"/><ellipse cx="16" cy="32" rx="6" ry="9" transform="rotate(45 16 32)"/><ellipse cx="32" cy="32" rx="6" ry="9" transform="rotate(-45 32 32)"/></g><circle cx="24" cy="24" r="5" fill="#fff1b8"/></svg></div><div><h1>Rappel Important</h1><div class="subtitle">Des mots qui réveillent le cœur</div></div></div><button class="small-btn" id="shareBtn">↗ Partager</button></header><main>
<section class="panel active" id="home"><div class="hero"><div class="eyebrow">Ton rappel du jour 🌸</div><h2 id="dailyTitle">Prends soin de ton cœur, un jour à la fois.</h2><p id="dailyText">Tu n’as pas besoin de tout réussir aujourd’hui. Fais un pas sincère, garde confiance en Allah et continue d’avancer.</p><div class="hero-actions"><button class="primary" id="newDaily">Un autre rappel</button><button class="secondary" id="goCategories">Explorer les rappels</button></div></div><div class="section-head"><h3>Explorer par thème</h3><span>Choisis un thème</span></div><div class="categories" id="homeCategories"></div><div class="section-head"><h3>À garder près du cœur</h3><span>Favoris</span></div><div id="homeFavorites"></div></section>
<section class="panel" id="rappels"><div class="section-head"><h3>Les rappels</h3><span id="countLabel">Tous les thèmes</span></div><input class="search" id="search" type="search" placeholder="Rechercher un rappel…"><div class="categories" id="allCategories" style="margin:12px 0 16px"></div><div id="reminderList"></div></section>
<section class="panel" id="favoris"><div class="section-head"><h3>Mes favoris 💗</h3><span>Sur cet appareil</span></div><div id="favoriteList"></div></section>
<section class="panel" id="ajouter"><div class="section-head"><h3>Mon rappel à moi ✍️</h3><span>Écris tes mots</span></div><div class="card"><p>Ajoute tes propres textes et retrouve-les dans tes rappels sur cet appareil.</p><form class="form-stack" id="addForm"><input type="text" id="customTitle" placeholder="Titre du rappel" required maxlength="60"><select id="customCategory"><option>Foi</option><option>Confiance en soi</option><option>Amour</option><option>Amitié</option><option>Famille</option><option>Tristesse</option><option>Avenir</option></select><textarea id="customText" placeholder="Écris ton rappel ici…" required maxlength="800"></textarea><button class="primary" type="submit">Enregistrer mon rappel</button></form><p class="note">Les textes personnalisés restent dans le navigateur de cet appareil. Garde aussi une copie de tes textes importants.</p></div></section>
<section class="panel" id="assistant"><div class="section-head"><h3>Conseils automatiques</h3><span>Écris ce que tu ressens</span></div><div class="card"><p style="line-height:1.6">Explique en quelques mots ce qui te préoccupe. L’assistant te proposera une réponse selon ton message.</p><form class="form-stack" id="adviceForm"><textarea id="adviceQuestion" placeholder="Ex. : Je me sens loin d’Allah, je veux reprendre la prière…" required maxlength="1000"></textarea><button class="primary" type="submit">Recevoir un conseil</button></form><div id="adviceAnswer" class="card" style="display:none;margin-top:14px;line-height:1.65"></div><p class="note">Cette version donne des réponses automatiques simples à partir de mots-clés. Ce n’est pas encore une IA connectée à Internet. Pour une vraie IA, il faudra connecter un service sécurisé sans mettre de clé secrète dans ce fichier.</p></div></section>
<section class="panel" id="apropos"><div class="section-head"><h3>À propos</h3><span>Rappel Important</span></div><div class="card"><h3>Un espace pour se rappeler l’essentiel 🤍</h3><p style="line-height:1.6">Rappel Important partage des pensées autour de la foi, de la vie, des relations et de la confiance en soi. Le but : encourager chacun à réfléchir, à grandir et à avancer avec sincérité.</p><p>Un projet personnel créé avec douceur, en rose et blanc. 🌸</p><button class="secondary" id="exportBtn">Copier mes favoris et mes textes</button></div></section></main></div>
<nav><button class="active" data-panel="home"><span class="nav-emoji"><svg viewBox="0 0 24 24" width="23" height="23" aria-hidden="true"><path d="M3 11 12 3l9 8v10h-6v-6H9v6H3z" fill="#f4bfd3" stroke="#b94f7a" stroke-width="1.4" stroke-linejoin="round"/></svg></span>Accueil</button><button data-panel="rappels"><span class="nav-emoji"><svg viewBox="0 0 24 24" width="23" height="23" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3" fill="#fff1f6" stroke="#b94f7a" stroke-width="1.4"/><path d="m4 7 8 6 8-6" fill="none" stroke="#b94f7a" stroke-width="1.5"/></svg></span>Rappels</button><button data-panel="assistant"><span class="nav-emoji"><svg viewBox="0 0 24 24" width="23" height="23" aria-hidden="true"><path d="M4 4h16v13H11l-5 4v-4H4z" fill="#fff1f6" stroke="#b94f7a" stroke-width="1.4" stroke-linejoin="round"/><circle cx="9" cy="10" r="1" fill="#b94f7a"/><circle cx="12" cy="10" r="1" fill="#b94f7a"/><circle cx="15" cy="10" r="1" fill="#b94f7a"/></svg></span>Conseils</button><button data-panel="favoris"><span class="nav-emoji"><svg viewBox="0 0 24 24" width="23" height="23" aria-hidden="true"><path d="M12 21S3 15.5 3 9.2C3 4.8 8.2 3.2 12 7c3.8-3.8 9-2.2 9 2.2C21 15.5 12 21 12 21Z" fill="#f4bfd3" stroke="#b94f7a" stroke-width="1.4"/></svg></span>Favoris</button><button data-panel="ajouter"><span class="nav-emoji"><svg viewBox="0 0 24 24" width="23" height="23" aria-hidden="true"><path d="m4 17-.8 4 4-.8L20 7.4 16.6 4z" fill="#f4bfd3" stroke="#b94f7a" stroke-width="1.3" stroke-linejoin="round"/><path d="m14.8 5.8 3.4 3.4" stroke="#b94f7a" stroke-width="1.3"/></svg></span>Créer</button><button data-panel="apropos"><span class="nav-emoji"><svg viewBox="0 0 24 24" width="23" height="23" aria-hidden="true"><path d="M12 21V11m0 5c-5 0-7-3-7-7 4 0 7 2 7 7Zm0-3c0-5 3-7 7-7 0 4-2 7-7 7Z" fill="#f4bfd3" stroke="#b94f7a" stroke-width="1.3" stroke-linejoin="round"/></svg></span>À propos</button></nav><div class="toast" id="toast"></div>
<script>
const base=[{id:'f1',title:'La confiance en Allah',category:'Foi',text:'Même quand tu ne comprends pas ce que tu traverses, rappelle-toi qu’Allah connaît ce que ton cœur ne sait pas expliquer. Fais les causes, invoque-Le et avance avec patience.'},{id:'f2',title:'Revenir à Allah',category:'Foi',text:'Tu n’as pas besoin d’être parfaite pour revenir vers Allah. Commence par un pas sincère, puis recommence chaque fois que tu en as besoin.'},{id:'c1',title:'Ta valeur ne dépend pas des autres',category:'Confiance en soi',text:'Ne mesure pas ta valeur à la beauté, aux réussites ou à la vie des autres. Tu avances à ton rythme, et chaque petit effort compte.'},{id:'c2',title:'Avance à ton rythme',category:'Confiance en soi',text:'Tu n’es pas en retard parce que ton chemin est différent. Apprends, essaie, recommence : ta progression n’a pas besoin de ressembler à celle des autres.'},{id:'a1',title:'L’amour doit respecter',category:'Amour',text:'Un lien sain ne te demande pas d’abandonner ton respect, tes valeurs ou ta paix. Tu mérites une relation fondée sur l’honnêteté et le respect mutuel.'},{id:'am1',title:'Les vraies amitiés',category:'Amitié',text:'Une vraie amitié te laisse être toi-même, te parle avec respect et ne se nourrit pas de tes blessures. Choisis les liens qui t’aident à grandir.'},{id:'fam1',title:'Le respect dans la famille',category:'Famille',text:'Les désaccords existent même dans une famille. Essaie de parler avec calme, mais rappelle-toi aussi que le respect doit aller dans les deux sens.'},{id:'t1',title:'Les jours difficiles',category:'Tristesse',text:'Tu as le droit d’avoir des jours où tout te semble lourd. Prends le temps de respirer, parle à une personne de confiance et avance petit à petit.'},{id:'av1',title:'Construire son avenir',category:'Avenir',text:'Ton avenir se construit aussi avec de petits pas : apprendre une chose, demander de l’aide, essayer encore. Ne méprise pas les débuts modestes.'},{id:'f3',title:'La patience a du sens',category:'Foi',text:'La patience ne veut pas dire que tout est facile. Continue à faire de ton mieux, invoque Allah et garde espoir dans les moments difficiles.'},{id:'f4',title:'Une intention sincère',category:'Foi',text:'Avant de commencer ta journée, renouvelle ton intention. Même une petite action faite avec sincérité peut avoir beaucoup de valeur.'},{id:'f5',title:'N’oublie pas les invocations',category:'Foi',text:'Quand ton cœur est inquiet, prends un instant pour invoquer Allah avec tes propres mots et continue à faire ce qui est en ton pouvoir.'},{id:'c3',title:'Ne te compare pas',category:'Confiance en soi',text:'Tu vois parfois les réussites des autres sans connaître leurs difficultés. Concentre-toi sur ce que tu peux apprendre et améliorer.'},{id:'c4',title:'Tu peux recommencer',category:'Confiance en soi',text:'Une erreur ne résume pas qui tu es. Apprends ce que tu peux, corrige ce qui est possible et donne-toi une nouvelle chance.'},{id:'c5',title:'Ose apprendre',category:'Confiance en soi',text:'Tu n’as pas besoin de tout savoir pour commencer. Pose des questions, pratique et accepte d’être débutante : c’est ainsi que l’on progresse.'},{id:'a2',title:'Les actes comptent',category:'Amour',text:'Les belles paroles font plaisir, mais le respect se voit aussi dans les actes : l’honnêteté, l’écoute et le respect de tes limites.'},{id:'a3',title:'Ne perds pas tes valeurs',category:'Amour',text:'Ne renonce pas à tes valeurs simplement pour retenir quelqu’un. Une relation saine respecte ce qui est important pour toi.'},{id:'am2',title:'Être une bonne amie',category:'Amitié',text:'Écoute sans humilier et garde les confidences avec sérieux. Une amitié solide se construit par de petites attentions sincères.'},{id:'am3',title:'Choisis la paix',category:'Amitié',text:'Tu peux aimer quelqu’un tout en prenant de la distance si une relation te fait du mal. Poser des limites peut te protéger.'},{id:'fam2',title:'Écouter avant de répondre',category:'Famille',text:'Quand une discussion devient tendue, prends quelques secondes avant de répondre. Parler avec calme aide à mieux se comprendre.'},{id:'fam3',title:'Les petites attentions',category:'Famille',text:'Un merci, un coup de main ou une parole douce peuvent rendre la journée d’un proche plus légère.'},{id:'t2',title:'Tu n’as pas à tout porter seule',category:'Tristesse',text:'Quand quelque chose te pèse, essaie d’en parler à une personne fiable et bienveillante. Demander du soutien n’est pas une faiblesse.'},{id:'t3',title:'Un jour à la fois',category:'Tristesse',text:'Tu n’es pas obligée de résoudre tous tes problèmes aujourd’hui. Choisis une petite chose utile et avance pas à pas.'},{id:'av2',title:'Apprendre est déjà avancer',category:'Avenir',text:'Chaque nouvelle compétence commence par un premier essai. Même si tu progresses lentement, ce que tu apprends aujourd’hui peut t’aider demain.'}];
const iconSvg=(n)=>{const paths={Tous:'<circle cx="12" cy="12" r="8" fill="#f4bfd3" stroke="#b94f7a" stroke-width="1.4"/><path d="M7 12h10M12 7v10" stroke="#b94f7a" stroke-width="1.4"/>',Foi:'<path d="M12 3 20 8v5c0 4-3 6-8 8-5-2-8-4-8-8V8z" fill="#f4bfd3" stroke="#b94f7a" stroke-width="1.4"/><path d="M8 12h8M12 8v8" stroke="#b94f7a" stroke-width="1.4"/>','Confiance en soi':'<circle cx="12" cy="12" r="9" fill="#fff1f6" stroke="#b94f7a" stroke-width="1.4"/><circle cx="12" cy="10" r="3" fill="#f4bfd3"/><path d="M6 18c1-4 11-4 12 0" fill="#f4bfd3" stroke="#b94f7a" stroke-width="1.4"/>',Amour:'<path d="M12 20S3 15 3 9c0-4 5-6 9-2 4-4 9-2 9 2 0 6-9 11-9 11z" fill="#f4bfd3" stroke="#b94f7a" stroke-width="1.4"/>',Amitié:'<circle cx="8" cy="8" r="4" fill="#f4bfd3" stroke="#b94f7a" stroke-width="1.2"/><circle cx="16" cy="8" r="4" fill="#fff1f6" stroke="#b94f7a" stroke-width="1.2"/><path d="M2 20c0-6 12-6 12 0M10 20c0-6 12-6 12 0" fill="none" stroke="#b94f7a" stroke-width="1.4"/>',Famille:'<path d="m3 11 9-7 9 7v9h-6v-6H9v6H3z" fill="#f4bfd3" stroke="#b94f7a" stroke-width="1.4"/>',Tristesse:'<path d="M12 3C9 8 5 11 5 15a7 7 0 0 0 14 0c0-4-4-7-7-12z" fill="#d8eafa" stroke="#477b9d" stroke-width="1.4"/>',Avenir:'<path d="M12 21V11m0 5c-5 0-7-3-7-7 4 0 7 2 7 7Zm0-3c0-5 3-7 7-7 0 4-2 7-7 7Z" fill="#f4bfd3" stroke="#b94f7a" stroke-width="1.4"/>'};return '<svg viewBox="0 0 24 24" role="img" aria-label="'+n+'">'+(paths[n]||paths.Tous)+'</svg>'};const cats=['Tous','Foi','Confiance en soi','Amour','Amitié','Famille','Tristesse','Avenir'];const =id=>document.getElementById(id);const load=(k,d)=>{try{return JSON.parse(localStorage.getItem(k))||d}catch{return d}};let custom=load('ri_custom',[]),favs=load('ri_favs',[]),cat='Tous',query='',daily=0;const all=()=>[...base,...custom];function save(){localStorage.setItem('ri_custom',JSON.stringify(custom));localStorage.setItem('ri_favs',JSON.stringify(favs))}function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}function toast(s){let t=('toast');t.textContent=s;t.style.display='block';setTimeout(()=>t.style.display='none',2200)}function go(id){document.querySelectorAll('.panel').forEach(p=>p.classList.toggle('active',p.id=id));document.querySelectorAll('nav button').forEach(b=>b.classList.toggle('active',b.dataset.panel=id));if(id==='rappels')renderList();if(id==='favoris')renderFavs();window.scrollTo(0,0)}function buttons(id){(id).innerHTML=cats.map(n=>`<button class="category ${cat===n?'active':''}" data-cat="${n}"><span class="emoji">${iconSvg(n)}</span><span>${n}</span></button>`).join('')}function card(r){let yes=favs.includes(r.id);return `<article class="card"><div class="card-top"><strong>${esc(r.title)}</strong><span class="tag">${esc(r.category)}</span><button class="favorite ${yes?'saved':''}" data-fav="${r.id}">${yes?'♥':'♡'}</button></div><p class="reminder-text">${esc(r.text)}</p><div class="card-actions"><button data-copy="${r.id}">Copier le texte</button><button data-share="${r.id}">Partager</button></div></article>`}function filtered(){return all().filter(r=>(cat==='Tous'||r.category===cat)&&(`${r.title} ${r.category} ${r.text}`).toLowerCase().includes(query.toLowerCase()))}function renderList(){buttons('allCategories');let a=filtered();('countLabel').textContent=a.length+' rappel(s)';('reminderList').innerHTML=a.length?a.map(card).join(''):'<div class="empty">Aucun rappel trouvé.</div>'}function renderFavs(){let a=all().filter(r=>favs.includes(r.id));('favoriteList').innerHTML=a.length?a.map(card).join(''):'<div class="empty">Appuie sur ♡ pour garder un rappel ici.</div>'}function renderHome(){buttons('homeCategories');let a=all().filter(r=>favs.includes(r.id)).slice(0,2);('homeFavorites').innerHTML=a.length?a.map(card).join(''):'<div class="empty">Tes rappels préférés apparaîtront ici.</div>'}async function copy(t){try{await navigator.clipboard.writeText(t);toast('Texte copié !')}catch{toast('Copie non disponible dans ce navigateur.')}}async function share(t){if(navigator.share){try{await navigator.share({title:'Rappel Important',text:t})}catch{}}else copy(t)}document.addEventListener('click',e=>{let n=e.target.closest('[data-panel]');if(n){go(n.dataset.panel);return}let c=e.target.closest('[data-cat]');if(c){cat=c.dataset.cat;renderList();renderHome();return}let f=e.target.closest('[data-fav]');if(f){favs=favs.includes(f.dataset.fav)?favs.filter(x=>x!==f.dataset.fav):[...favs,f.dataset.fav];save();renderHome();renderList();renderFavs();return}let b=e.target.closest('[data-copy]');if(b){let r=all().find(x=>x.id===b.dataset.copy);if(r)copy(r.title+'\n\n'+r.text);return}let s=e.target.closest('[data-share]');if(s){let r=all().find(x=>x.id===s.dataset.share);if(r)share(r.title+'\n\n'+r.text+'\n\n— Rappel Important')}});('adviceForm').addEventListener('submit',e=>{e.preventDefault();const q=('adviceQuestion').value.toLowerCase();let a='Prends un moment pour respirer et nommer ce dont tu as besoin. Avance par une petite étape à la fois et, si cela te pèse beaucoup, parle à une personne de confiance.';if(/allah|foi|prière|priere|salat|islam|haram|péché|peche|invocation/.test(q))a='Reviens vers Allah avec sincérité, même par un petit pas. Essaie de préserver la prière, apprends les invocations progressivement et demande à Allah de te faciliter. Ne désespère pas de Sa miséricorde.';else if(/triste|pleure|seule|solitude|mal au cœur|mal au coeur|déprime|deprime/.test(q))a='Je suis désolé que ce soit lourd en ce moment. Tu n’as pas à tout régler tout de suite. Repose-toi, écris ce que tu ressens et cherche une personne bienveillante à qui parler.';else if(/famille|mère|mere|père|pere|parent|dispute/.test(q))a='Essaie de choisir un moment calme pour expliquer ce que tu ressens avec respect. Écouter aide, mais tu as aussi le droit d’être écoutée. Si tu ne te sens pas en sécurité, cherche l’aide d’un adulte fiable.';else if(/amour|copain|trahi|trahison|relation/.test(q))a='Ne laisse pas une relation te faire oublier tes valeurs et ta tranquillité. Regarde les actes, pas seulement les paroles, et parle à quelqu’un de confiance si tu es blessée.';else if(/avenir|travail|formation|école|ecole|étude|etude|réussir|reussir/.test(q))a='Tu peux commencer petit : choisis une compétence à apprendre, pose une question et fais un pas concret cette semaine. Être débutante ne t’empêche pas de construire un bel avenir.';else if(/peur|stress|angoisse|anxieuse|anxieux/.test(q))a='Essaie de ralentir un instant, de respirer doucement et de séparer ce que tu peux faire de ce que tu ne contrôles pas. Une petite action concrète et une personne de confiance peuvent t’aider.';else if(/confiance|belle|beauté|beaute|compar/.test(q))a='Ta valeur ne se résume pas à ton apparence ni à la comparaison avec les autres. Concentre-toi sur ce que tu apprends, sur tes qualités et sur les gestes qui te rapprochent de la personne que tu veux devenir.';('adviceAnswer').textContent=a;('adviceAnswer').style.display='block'});('search').addEventListener('input',e=>{query=e.target.value;renderList()});('addForm').addEventListener('submit',e=>{e.preventDefault();custom.unshift({id:'c'+Date.now(),title:('customTitle').value.trim(),category:('customCategory').value,text:('customText').value.trim()});save();e.target.reset();renderHome();renderList();go('rappels');toast('Ton rappel est enregistré !')});('newDaily').addEventListener('click',()=>{daily=(daily+1)\%base.length;('dailyTitle').textContent=base[daily].title;('dailyText').textContent=base[daily].text});('goCategories').addEventListener('click',()=>go('rappels'));('shareBtn').addEventListener('click',()=>share('Découvre Rappel Important : des mots qui réveillent le cœur. 🌸'));('exportBtn').addEventListener('click',()=>copy(JSON.stringify({favoris:all().filter(r=>favs.includes(r.id)),mesRappels:custom},null,2)));renderHome();renderList();renderFavs();
</script></body></html>
